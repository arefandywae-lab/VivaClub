# VivaClub Production Environment Variables
# Copy this to .env.production on VPS and fill in the values

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://vivaclub:CHANGE_ME@postgres:5432/vivaclub
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Redis Cache
# ============================================
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================
# MinIO (Image Storage)
# ============================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_PASSWORD
AWS_STORAGE_BUCKET_NAME=vivaclub-media
AWS_S3_ENDPOINT_URL=http://minio:9000
DOMAIN=yourdomain.com

# ============================================
# LiveKit (Audio Streaming)
# ============================================
LIVEKIT_API_URL=wss://yourdomain.com/livekit
LIVEKIT_API_KEY=APIxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME_STRONG_PASSWORD

# ============================================
# Firebase (Authentication)
# ============================================
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-credentials.json

# ============================================
# Django Settings
# ============================================
SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY_50_CHARS
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================
# GitHub (for Docker image)
# ============================================
GITHUB_USERNAME=your-github-username

# ============================================
# Optional: Email (for notifications)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# How to generate secure passwords:
# ============================================
# Run on VPS: openssl rand -base64 32
# Or use: https://passwordsgenerator.net/
