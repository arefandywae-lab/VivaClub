# Caddyfile for Auto-HTTPS configuration

# 1. Main API / Web Traffic
vivaclubs.site, www.vivaclubs.site {
    # Serve Static Files
    handle_path /static/* {
        root * /app/backend/staticfiles
        file_server
    }

    # Serve Media Files
    handle_path /media/* {
        root * /app/backend/mediafiles
        file_server
    }

    # Bot Service API (must be handle_path BEFORE the catch-all handle below)
    handle_path /bot-api/* {
        reverse_proxy vivaclub_bot_service:9090
    }

    # Fallback: Proxy everything else to Django (HTTP + WebSocket)
    handle {
        reverse_proxy vivaclub_backend:8000
    }
}

# 2. LiveKit Traffic
# Note: LiveKit is running on host network, so proxy to localhost
livekit.vivaclubs.site {
    reverse_proxy 217.216.108.16:7880
}

# 3. Next.js Admin Dashboard
dashboard.vivaclubs.site {
    reverse_proxy vivaclub_dashboard:3000
}
