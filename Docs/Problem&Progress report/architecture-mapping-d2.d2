direction: right
classes: {
  client: {
    style: {
      stroke: "#333333"
      fill: "#f9f9f9"
      shadow: true
      border-radius: 8
    }
  }
  proxy: {
    style: {
      stroke: "#0066cc"
      fill: "#e6f2ff"
    }
  }
  backend: {
    style: {
      stroke: "#009933"
      fill: "#e6ffe6"
    }
  }
  media: {
    style: {
      stroke: "#cc0000"
      fill: "#ffe6e6"
    }
  }
  database: {
    shape: cylinder
    style: {
      stroke: "#9900cc"
      fill: "#f2e6ff"
    }
  }
  bot: {
    style: {
      stroke: "#e6b800"
      fill: "#fffbe6"
    }
  }
}

title: "VivaClub Infrastructure Details"
description: "Detailed Component, Layout & Port Mapping"

# External Zone
Public Internet: {
  style: {
    fill: transparent
    stroke: transparent
  }

  Flutter: "Flutter Mobile (Users)" {
    class: client
  }
  AdminBrowser: "Next.js Admin UI" {
    class: client
  }
}

# Gateway Zone
Gateway: {
  class: proxy

  Caddy: "Caddy Reverse Proxy" {
    tooltip: "Ports 80/443 (Auto SSL/TLS)"
  }
}

# Internal Network (VPS)
Internal VPC: {
  style.fill: "#fcfcfa"
  style.border-radius: 10

  # Backend Layer
  Backend Services: {
    DjangoAPI: "Django API (Sync)" {
      class: backend
      tooltip: "REST Framework (Port: 8000)"
    }
    DaphneWS: "Daphne ASGI (Async)" {
      class: backend
      tooltip: "WebSockets (Port: 8000)"
    }
    NextJS: "Next.js Admin Server" {
      class: backend
      tooltip: "SSR UI (Port: 3000)"
    }
  }

  # Media Layer
  Media Cluster: {
    class: media

    LiveKitAPI: "LiveKit Signaling" {
      tooltip: "Port: 7880 (HTTP/WS)"
    }
    LiveKitRTC: "LiveKit RTC Engine" {
      tooltip: "Port: 7882 (UDP/TCP)"
    }
  }

  # Data Layer
  Data Storage: {
    class: database

    PostgreSQL: "PostgreSQL DB" {
      tooltip: "Users, Rooms, Settings (Port: 5432)"
    }
    Redis: "Redis Broker" {
      tooltip: "Channel Layers, Worker Queues (Port: 6379)"
    }
  }

  # Background Workers
  Background Workers: {
    PythonBot: "AI Companion Worker" {
      class: bot
      tooltip: "Listens to Redis for assignments"
    }
  }
}

# === COMMUNICATIONS ===
# Public Internet to Gateway
Public Internet.Flutter -> Gateway.Caddy: "1. REST API (HTTPS)\nPOST /api/community/*" {
  style.stroke: "#0066cc"
}
Gateway.Caddy -> Public Internet.Flutter: "JSON + JWT Tokens" {
  style.stroke: "#0066cc"
}

Public Internet.Flutter -> Gateway.Caddy: "2. WSS Connections\n/ws/notifications/" {
  style.stroke: "#009933"
}
Gateway.Caddy -> Public Internet.Flutter: "JSON Pusher\n(Event notifications)" {
  style.stroke: "#009933"
}

Public Internet.Flutter -> Internal VPC.Media Cluster.LiveKitAPI: "3. WSS Signaling\n(Port 7880)" {
  style.stroke: "#e6b800"
}
Internal VPC.Media Cluster.LiveKitAPI -> Public Internet.Flutter: "RoomUpdates,\nParticipantJoined" {
  style.stroke: "#e6b800"
}

Public Internet.Flutter <-> Internal VPC.Media Cluster.LiveKitRTC: "4. UDP Media (Port 7882)\n[Opus Audio Streams]" {
  style.stroke-dash: 5
  style.stroke: "#cc0000"
  style.animated: true
}

Public Internet.AdminBrowser -> Gateway.Caddy: "5. Browser Navigation\nadmin.vivaclubs.site"

# Gateway Routing Rules
Gateway.Caddy -> Internal VPC.Backend Services.DjangoAPI: "/api/* ➔ HTTP:8000" {
  style.stroke: "#0066cc"
}
Internal VPC.Backend Services.DjangoAPI -> Gateway.Caddy: "200 OK / 401 Unauthorized" {
  style.stroke: "#0066cc"
}

Gateway.Caddy -> Internal VPC.Backend Services.DaphneWS: "/ws/* ➔ HTTP:8000" {
  style.stroke: "#009933"
}
Gateway.Caddy -> Internal VPC.Backend Services.NextJS: "*.admin.* ➔ HTTP:3000"

# Internal Backend Logistics
Internal VPC.Backend Services.NextJS -> Internal VPC.Backend Services.DjangoAPI: "Fetch Data\nGET /api/auth/admin/*"
Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Backend Services.NextJS: "Admin Statistics"

Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Data Storage.PostgreSQL: "Read/Write SQL" {
  style.stroke: "#9900cc"
}
Internal VPC.Data Storage.PostgreSQL -> Internal VPC.Backend Services.DjangoAPI: "SQL Results" {
  style.stroke: "#9900cc"
}

Internal VPC.Backend Services.DaphneWS -> Internal VPC.Data Storage.PostgreSQL: "Check Auth State" {
  style.stroke: "#9900cc"
}
Internal VPC.Data Storage.PostgreSQL -> Internal VPC.Backend Services.DaphneWS: "Auth Results" {
  style.stroke: "#9900cc"
}

# Redis Queues / Pub-Sub
Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Data Storage.Redis: "1. Publish Channel msg\n[Payload: kick]" {
  style.stroke: "#ff6600"
}
Internal VPC.Data Storage.Redis -> Internal VPC.Backend Services.DaphneWS: "2. Consume Channel Queue\n[Triggers WS Push]" {
  style.stroke: "#ff6600"
}

Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Data Storage.Redis: "3. LPUSH Task Queue\n[bot_join_room_ID]" {
  style.stroke: "#ff6600"
}
Internal VPC.Data Storage.Redis -> Internal VPC.Background Workers.PythonBot: "4. BLPOP Consume Task" {
  style.stroke: "#ff6600"
}

# API <-> LiveKit Controller / Webhooks
Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Media Cluster.LiveKitAPI: "Admin API Commands\n[MuteParticipant]"
Internal VPC.Media Cluster.LiveKitAPI -> Internal VPC.Backend Services.DjangoAPI: "Webhooks\n(POST /api/webhooks/)"

# Bot Lifecycle connections
Internal VPC.Background Workers.PythonBot -> Internal VPC.Backend Services.DjangoAPI: "1. Request Bot Token"
Internal VPC.Backend Services.DjangoAPI -> Internal VPC.Background Workers.PythonBot: "JWT Room Token"

Internal VPC.Background Workers.PythonBot -> Internal VPC.Media Cluster.LiveKitAPI: "2. Connect Signaling WS" {
  style.stroke: "#e6b800"
}
Internal VPC.Background Workers.PythonBot -> Internal VPC.Media Cluster.LiveKitRTC: "3. Stream Bot Audio\n(UDP/10ms frames)" {
  style.stroke-dash: 5
  style.stroke: "#cc0000"
}
Internal VPC.Media Cluster.LiveKitRTC -> Internal VPC.Background Workers.PythonBot: "Receive Room Audio" {
  style.stroke-dash: 5
  style.stroke: "#cc0000"
}
